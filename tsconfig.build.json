{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/*.ts",
    "src/index.ts",
    "src/types.ts",
    "src/core/**/*.ts",
    "src/utils/**/*.ts",
    "src/values/**/*.ts",
    "src/physics/**/*.ts",
    "src/operators/**/*.ts",
    "src/adapters/**/*.ts",
    "src/effects/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/docs"
  ]
}

{
  "name": "@re-code/flux",
  "version": "0.1.0",
  "description": "A headless, reactive animation engine built on TypeScript and RxJS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "apps/docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js",
      "default": "./dist/values.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js",
      "default": "./dist/physics.js"
    },
    "./operators": {
      "types": "./dist/operators.d.ts",
      "import": "./dist/operators.js",
      "default": "./dist/operators.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./dom": {
      "types": "./dist/adapters/dom.d.ts",
      "import": "./dist/adapters/dom.js",
      "default": "./dist/adapters/dom.js"
    },
    "./svg": {
      "types": "./dist/adapters/svg.d.ts",
      "import": "./dist/adapters/svg.js",
      "default": "./dist/adapters/svg.js"
    },
    "./canvas": {
      "types": "./dist/adapters/canvas.d.ts",
      "import": "./dist/adapters/canvas.js",
      "default": "./dist/adapters/canvas.js"
    },
    "./three": {
      "types": "./dist/adapters/three.d.ts",
      "import": "./dist/adapters/three.js",
      "default": "./dist/adapters/three.js"
    },
    "./effects/canvas": {
      "types": "./dist/effects/canvas.d.ts",
      "import": "./dist/effects/canvas.js",
      "default": "./dist/effects/canvas.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc -p tsconfig.build.json",
    "dev": "npm run dev --workspace=re-flux-docs",
    "build": "npm run build:lib && npm run build --workspace=re-flux-docs",
    "preview": "npm run preview --workspace=re-flux-docs",
    "prepack": "npm run check:roadmap && npm run check:workflow-sync && npm run typecheck && npm run typecheck:tests && npm test -- --runInBand && npm run build:lib && node scripts/check-tree-shaking.mjs && node scripts/check-package-files.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "npm test -- --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "bench": "npm run build:lib && node benchmarks/frame-coordinator.bench.mjs",
    "check:tree-shaking": "npm run build:lib && node scripts/check-tree-shaking.mjs",
    "check:package": "npm run build:lib && node scripts/check-package-files.mjs",
    "check:visual-lab": "node scripts/check-visual-lab.mjs",
    "check:playground-lifecycle": "node scripts/check-playground-lifecycle.mjs",
    "check:release": "node scripts/check-release-tag.mjs",
    "sync:roadmap": "node scripts/sync-roadmap.mjs --write",
    "check:roadmap": "node scripts/sync-roadmap.mjs --check",
    "check:workflow-sync": "node scripts/check-workflow-sync.mjs"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/node": "^22.10.0",
    "jest": "^30.2.0",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.5",
    "typescript": "~5.7.2",
    "esbuild": "^0.24.2"
  },
  "keywords": [
    "animation",
    "canvas",
    "easing",
    "gesture",
    "headless",
    "interpolation",
    "layout-animation",
    "physics",
    "re-code",
    "rxjs",
    "scroll-animation",
    "stream-smoothing",
    "svg-path",
    "timeline",
    "typescript",
    "utilities"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamcodex96/re-flux.git"
  },
  "homepage": "https://iamcodex96.github.io/re-flux/",
  "bugs": {
    "url": "https://github.com/iamcodex96/re-flux/issues"
  }
}
